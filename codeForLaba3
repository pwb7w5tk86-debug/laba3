    public static int[] ArrayGnomych(int[] originalArray)
    {
        int[] array = GetArrayCopy(originalArray);
        int index = 0;
        int n = array.Length;
        while (index < n)
        {
            if (index == 0 || array[index] >= array[index - 1])
            {
                index++;
            }
            else
            {
                int element = array[index];
                array[index] = array[index - 1];
                array[index - 1] = element;

                index--;
            }
        }
        return array;
    }

    public static TimeSpan ArrayGnomychTime(int[] originalArray)
    {
        int[] array = GetArrayCopy(originalArray);
        Stopwatch timer1 = Stopwatch.StartNew();
        ArrayGnomych(array);
        timer1.Stop();
        return timer1.Elapsed;
    }

    public static int[] ArrayShell(int[] originalArray)
    {
        int[] array = GetArrayCopy(originalArray);
        int n = array.Length;

        for (int gap = n / 2; gap > 0; gap /= 2)
        {
            for (int i = gap; i < n; i++)
            {
                int temp = array[i];
                int j;

                for (j = i; j >= gap && array[j - gap] > temp; j -= gap)
                {
                    array[j] = array[j - gap];
                }

                array[j] = temp;
            }
        }
        return array;
    }

    public static TimeSpan ArrayShellTime(int[] originalArray)
    {
        int[] array = GetArrayCopy(originalArray);
        Stopwatch timer2 = Stopwatch.StartNew();
        ArrayShell(array);
        timer2.Stop();

        return timer2.Elapsed;
    }

