    static double Proverka(string chislo)
    {
        double number;
        Console.WriteLine(chislo);

        while (!double.TryParse(Console.ReadLine(), out number))
        {
            Console.WriteLine("Ошибка ввода! Пожалуйста, введите корректное число.");
            Console.WriteLine(chislo);
        }

        return number;
    }

    static void Igra()
    {

        double a = Proverka("Введите значение первого аргумента (a): ");
        double b = Proverka("Введите значение второго аргумента (b): ");

        if (Math.Cos(b) >= 0)
        {
            double correctAnswer = Vychislenia(a, b);
            Ugadaika(correctAnswer);
        }
        else
        {
            Console.WriteLine("Ошибка: косинус меньше нуля!");
        }
    }

    static double Vychislenia(double a, double b)
    {
        double p = Math.PI;
        double res = Math.Pow(Math.Sin(3 * p / 4 + a / 3), 2) + Math.Pow(Math.Cos(b), 0.5);
        return Math.Round(res, 2);
    }

    static void Ugadaika(double correctAnswer)
    {
        int popytka = 3;

        while (popytka > 0)
        {
            Console.WriteLine($"У вас осталось попыток: {popytka} ");
            Console.WriteLine("Вы считаете, что результат: ");

            if (double.TryParse(Console.ReadLine(), out double resultUser1))
            {
                double resultUser = Math.Round(resultUser1, 2);
                if (resultUser == correctAnswer)
                {
                    Console.WriteLine("Вы молодец!");
                    return;
                }
                else
                {
                    popytka -= 1;

                    if (popytka > 0)
                    {
                        Console.WriteLine("Неверно, попробуйте еще.");
                    }
                    else
                    {
                        Console.WriteLine($"Попытки закончились. Правильный ответ: {correctAnswer}");
                    }
                }
            }
            else
            {
                Console.WriteLine("Некорректный ввод числа! Попробуйте снова.");
            }
        }
    }

